<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true">
    <!--
        Two suites, split by how much they boot (statamic-package-conventions):
        `Unit` is pure PHP, and `Integration` boots a minimal Statamic through
        Orchestra Testbench. There is no `Feature` suite: the add-on has no host
        application of its own.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory suffix="Test.php">./tests/Integration</directory>
        </testsuite>
    </testsuites>
    <!-- The add-on's own code: what coverage and mutation testing measure. -->
    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
        <!-- Large machine-generated reference-data enums: php-code-coverage's static analyser
             exhausts memory on them. Mirrors phpstan.neon.dist `excludePaths.analyse`. -->
        <exclude>
            <file>./src/CanadianProvince.php</file>
            <file>./src/Country.php</file>
            <file>./src/County.php</file>
            <file>./src/CredentialRegistry.php</file>
            <file>./src/Currency.php</file>
            <file>./src/InternationalCodeDesignator.php</file>
            <file>./src/IscedA2011.php</file>
            <file>./src/IscedF2013.php</file>
            <file>./src/IscedP2011.php</file>
            <file>./src/Isco08.php</file>
            <file>./src/Language.php</file>
            <file>./src/LanguageBCP47.php</file>
            <file>./src/MimeType.php</file>
            <file>./src/SchemaDataType.php</file>
            <file>./src/SchemaEnumerationMember.php</file>
            <file>./src/SchemaProperty.php</file>
            <file>./src/SchemaType.php</file>
            <file>./src/State.php</file>
            <file>./src/ZipCode.php</file>
        </exclude>
    </source>
</phpunit>
